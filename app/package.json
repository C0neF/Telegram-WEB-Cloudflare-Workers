{
  "name": "telegram-web-proxy",
  "version": "1.0.0",
  "description": "Zero-cost Telegram WEB Proxy on Cloudflare Workers Free + SQLite Durable Objects — WebSocket carrier, MTProxy translation, bounded relay",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "telegram",
    "mtproxy",
    "web-proxy",
    "cloudflare-workers",
    "durable-objects",
    "websocket"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import ./test-support/register-cloudflare-hooks.mjs --test",
    "test:runtime": "vitest run --config vitest.config.js",
    "test:all": "npm test && npm run test:runtime",
    "test:watch": "node --import ./test-support/register-cloudflare-hooks.mjs --test --watch",
    "dev": "wrangler dev --config ../wrangler.toml --local --port 8792",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "deploy:dry": "wrangler deploy --dry-run --config ../wrangler.toml",
    "probe": "node scripts/public-relay-probe.mjs",
    "lint": "node scripts/check-syntax.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.1",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  }
}
